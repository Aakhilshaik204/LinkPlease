# ── Environment variables ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Your PseudoGram API key (from POST /v1/keygen)
PSEUDOGRAM_API_KEY=your_api_key_here

# The base URL of the mock API
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# Path to SQLite database file
DB_PATH=linkplease.db

# Worker settings
DM_MAX_ATTEMPTS=5
DM_BASE_BACKOFF_SECONDS=1
RECONCILE_INTERVAL_SECONDS=30

# How many DM workers run concurrently (keep <= 10 to respect rate limit)
WORKER_CONCURRENCY=3
